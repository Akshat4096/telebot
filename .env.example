# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Anthropic API key used by the Claude Agent SDK (which shells out to the
# `claude` CLI under the hood).
ANTHROPIC_API_KEY=sk-ant-...

# Where the SQLite DB file lives. MUST be a real local disk path — SQLite's
# WAL mode does not work reliably over network-mounted / FUSE filesystems
# (we hit this ourselves during development: `disk I/O error` on a mounted
# drive, fine on local disk). Defaults to ./data/kirana.db if unset.
KIRANA_DB_PATH=./data/kirana.db
